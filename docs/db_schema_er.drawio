        <!-- title -->
        <mxCell id="title" value="PARKDRONE — Web Tier Database (Postgres 16 + PostGIS 3.4)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#14181D;" vertex="1" parent="1">
          <mxGeometry x="60" y="24" width="700" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Schema of web/packages/db/migrations/0001_init.sql. Postgres is the system of record: the S3/MinIO bucket holds only transient frame pixels and the job queue is in-process, so everything durable lives here. Crow's-foot notation; the dashed link is a logical join with no foreign key." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="60" y="58" width="1000" height="30" as="geometry" />
        </mxCell>

