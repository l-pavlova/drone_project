        <!-- ===== notes ===== -->
        <mxCell id="note_durab" value="Durability without a broker, and now N replicas without one either (migration 0011). frame (append-only ledger) and frame_job (work state) are written in ONE transaction, so every committed frame has a claimable job. Work is CLAIMED with FOR UPDATE SKIP LOCKED under a lease, so replicas split one backlog instead of both doing all of it — and the claim query&#39;s second arm takes back any lease that stopped being renewed, which means a LIVE replica recovers a dead one&#39;s work rather than waiting for it to restart. observation is unique per (frame_id, bay_id), because at-least-once delivery would otherwise double-count the vote. A frame whose image has expired is marked failed on the first attempt so nothing loops on it." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#33383d;" vertex="1" parent="1">
          <mxGeometry x="1150" y="850" width="230" height="130" as="geometry" />
        </mxCell>
        <mxCell id="note_config" value="config.py is read by pool.py, s3.py, routing.py, vision_db.py and server.py — arrows omitted to keep the diagram readable." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="40" y="440" width="190" height="70" as="geometry" />
        </mxCell>
        <mxCell id="note_reuse" value="score_occupancy.py is the ONE home of the tuned thresholds; the server imports it instead of copying it, and replay.py proves the live path still agrees with the offline one." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="1150" y="345" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="Legend — bold red solid = thread crossing · dashed = uses / calls · folder = Python subpackage · cylinder = data store. Per-module write-up: docs/server_modules.md · schema: docs/db_schema_er.md · system level: web/docs/architecture.drawio." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="40" y="1070" width="1320" height="20" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
