<mxfile host="app.diagrams.net" agent="parkdrone" version="24.0.0">
  <diagram name="PARKDRONE — Server Module Map" id="parkdrone-server-modules">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1120" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- title -->
        <mxCell id="title" value="PARKDRONE Server — Module Map (inside the FastAPI monolith)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#14181D;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="760" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Zooms into the &quot;PARKDRONE Server&quot; component of web/docs/architecture.drawio. One Python process owns the HTTP/WS edge AND the vision CV. The api/ ↔ processing/ line is a THREAD boundary: api/ runs on request threads (plus the event loop for WS), processing/ on dedicated classify threads; jobs.wake() and the delta listener&#39;s run_coroutine_threadsafe(hub.deliver) are the only two crossings — and note the second is no longer a classify thread reaching into the hub, but a Postgres NOTIFY arriving." style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="40" y="48" width="1010" height="40" as="geometry" />
        </mxCell>

        <!-- ===== external clients ===== -->
        <mxCell id="drone" value="&#171;component&#187;&#10;Drone / Webots sim&#10;frames + poses&#10;&lt;i&gt;sim posts via sim_uplink&lt;/i&gt;" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=11;fillColor=#EEF1F3;strokeColor=#9AA6AE;fontColor=#14181D;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="164" width="170" height="72" as="geometry" />
        </mxCell>
        <mxCell id="browser" value="&#171;component&#187;&#10;web-user&#10;React + Leaflet" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=11;fillColor=#E6F6EC;strokeColor=#2E9E57;fontColor=#0f4023;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="admin" value="&#171;component&#187;&#10;web-admin&#10;React ops dashboard :5174" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=11;fillColor=#E4F7F4;strokeColor=#0F9E90;fontColor=#06403a;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="375" width="170" height="55" as="geometry" />
        </mxCell>
        <mxCell id="operator" value="&#171;actor&#187;&#10;Operator shell" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=11;fillColor=#EEF1F3;strokeColor=#9AA6AE;fontColor=#14181D;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="905" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- ===== the process ===== -->
        <mxCell id="proc" value="&#171;process&#187;  parkdrone_vision — Python / FastAPI, single process on :4000" style="rounded=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontStyle=1;fillColor=#EAF2FB;strokeColor=#3B6FB0;fontColor=#1a3a5c;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="110" width="830" height="720" as="geometry" />
        </mxCell>

        <!-- ==== api/ ==== -->
        <mxCell id="pkg_api" value="api/  — HTTP + WebSocket edge" style="shape=folder;tabWidth=170;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#E4F7F4;strokeColor=#0F9E90;fontColor=#06403a;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="150" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m_app" value="&lt;b&gt;app.py&lt;/b&gt;&#10;FastAPI app + lifespan (pool · bays · threads · delta listener)&#10;ingest · reads (/bays /summary /bays/:id) · /route&#10;metrics · dev occupancy toggle · WS /ws/occupancy&#10;sync handlers → Starlette threadpool" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#0F9E90;fontColor=#06403a;" vertex="1" parent="1">
          <mxGeometry x="285" y="186" width="350" height="72" as="geometry" />
        </mxCell>
        <mxCell id="m_auth" value="&lt;b&gt;auth.py&lt;/b&gt;&#10;require_drone dependency&#10;x-api-key → SHA-256 → drone_id&#10;bumps last_seen · 401 / 403" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#0F9E90;fontColor=#06403a;" vertex="1" parent="1">
          <mxGeometry x="285" y="266" width="168" height="62" as="geometry" />
        </mxCell>
        <mxCell id="m_hub" value="&lt;b&gt;hub.py&lt;/b&gt;&#10;WS fan-out to THIS replica&#39;s clients&#10;deliver(msg) verbatim&#10;no cursor, no buffer — both in bay_delta" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#0F9E90;fontColor=#06403a;" vertex="1" parent="1">
          <mxGeometry x="467" y="266" width="168" height="62" as="geometry" />
        </mxCell>
        <mxCell id="m_dlisten" value="&lt;b&gt;delta_listener.py&lt;/b&gt;&#10;LISTEN bay_delta (own conn, autocommit)&#10;any replica&#39;s delta → hub.deliver" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#0F9E90;fontColor=#06403a;" vertex="1" parent="1">
          <mxGeometry x="467" y="336" width="168" height="48" as="geometry" />
        </mxCell>
        <mxCell id="m_deltas" value="&lt;b&gt;deltas.py&lt;/b&gt;&#10;publish(): bay_delta row + pg_notify,&#10;IN the caller&#39;s transaction — NOTIFY fires on&#10;COMMIT, so the wire is never ahead of the DB.&#10;bay_delta.id IS the shared ?since cursor." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#0F9E90;fontColor=#06403a;" vertex="1" parent="1">
          <mxGeometry x="871" y="292" width="174" height="82" as="geometry" />
        </mxCell>
        <mxCell id="m_metrics" value="&lt;b&gt;metrics.py&lt;/b&gt;&#10;GET /api/v1/metrics (JSON) · GET /metrics (Prometheus text, no client lib)&#10;in-process: queue depth · in-flight · lifetime totals    durable: job counts · oldest-queued age · ingest rate · latency p50/p95 · fleet · coverage · model accuracy" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fillColor=#FFFFFF;strokeColor=#0F9E90;fontColor=#06403a;" vertex="1" parent="1">
          <mxGeometry x="285" y="336" width="168" height="48" as="geometry" />
        </mxCell>

        <!-- ==== processing/ ==== -->
        <mxCell id="pkg_proc" value="processing/  — frame → occupancy" style="shape=folder;tabWidth=180;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#FDE9E4;strokeColor=#E14B2E;fontColor=#5c1c10;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="150" width="380" height="240" as="geometry" />
        </mxCell>
        <mxCell id="m_jobs" value="&lt;b&gt;jobs.py&lt;/b&gt;&#10;dispatcher CLAIMS → queue.Queue → N classify threads&#10;each thread with its own DB conn; prefetch kept shallow&#10;failure releases the lease, gives up at MAX_ATTEMPTS&#10;no recover(): a lapsed lease is reclaimable by anyone" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#E14B2E;fontColor=#5c1c10;" vertex="1" parent="1">
          <mxGeometry x="695" y="188" width="350" height="90" as="geometry" />
        </mxCell>
        <mxCell id="m_pipeline" value="&lt;b&gt;pipeline.py&lt;/b&gt;&#10;process_frame(): score → insert observations → recompute bay_state → commit → return deltas&#10;shared verbatim by the live classify threads AND replay.py" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#E14B2E;fontColor=#5c1c10;" vertex="1" parent="1">
          <mxGeometry x="695" y="292" width="168" height="82" as="geometry" />
        </mxCell>

        <!-- ==== db/ ==== -->
        <mxCell id="pkg_db" value="db/  — all SQL" style="shape=folder;tabWidth=140;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#EEF1F3;strokeColor=#6b7686;fontColor=#14181D;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="420" width="380" height="230" as="geometry" />
        </mxCell>
        <mxCell id="m_pool" value="&lt;b&gt;pool.py&lt;/b&gt;&#10;ThreadedConnectionPool(1..10)&#10;borrow(commit=…)" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#6b7686;fontColor=#14181D;" vertex="1" parent="1">
          <mxGeometry x="285" y="458" width="168" height="56" as="geometry" />
        </mxCell>
        <mxCell id="n_conn" value="pool.py serves REQUEST threads only.&#10;Classify threads call vision_db.connect()&#10;for their own long-lived connection —&#10;psycopg2 conns aren't thread-shareable." style="rounded=0;dashed=1;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fillColor=none;strokeColor=#9AA6AE;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="467" y="458" width="168" height="56" as="geometry" />
        </mxCell>
        <mxCell id="m_webdb" value="&lt;b&gt;web_db.py&lt;/b&gt;&#10;reads: GeoJSON · summary&#10;· detail · nearest (PostGIS)&#10;ingest + mission writes&#10;frame ⊕ frame_job in 1 tx&#10;unscored_frames() backlog&#10;drone auth lookups" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#6b7686;fontColor=#14181D;" vertex="1" parent="1">
          <mxGeometry x="285" y="530" width="168" height="105" as="geometry" />
        </mxCell>
        <mxCell id="m_visdb" value="&lt;b&gt;vision_db.py&lt;/b&gt;&#10;connect() — one conn/thread&#10;load_bays_enu (WGS84→ENU)&#10;insert_observations&#10;recompute_states:&#10;strict majority vote →&#10;upsert bay_state → deltas" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#6b7686;fontColor=#14181D;" vertex="1" parent="1">
          <mxGeometry x="467" y="530" width="168" height="105" as="geometry" />
        </mxCell>

        <!-- ==== vision/ ==== -->
        <mxCell id="pkg_vision" value="vision/  — classifier bridge" style="shape=folder;tabWidth=170;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#FFF6E0;strokeColor=#C08A11;fontColor=#5a3f05;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="680" y="420" width="380" height="250" as="geometry" />
        </mxCell>
        <mxCell id="m_scoring" value="&lt;b&gt;scoring.py&lt;/b&gt;&#10;score_frame(img, bays, pose) — project each bay ring to pixels, skip off-frame / half-hidden, classify&#10;re-exports project · bay_features · classify · to_enu · pose_idx, so the tuned thresholds live in ONE place" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#C08A11;fontColor=#5a3f05;" vertex="1" parent="1">
          <mxGeometry x="695" y="458" width="350" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m_gt" value="&lt;b&gt;ground_truth.py&lt;/b&gt; — EVAL ONLY&#10;labels_for(survey_area) → sim/worlds/&lt;area&gt;.ground_truth.json&#10;caches hits AND misses (production is the miss case) · area name whitelisted: it reaches a file path from HTTP&#10;no file → gt = NULL → accuracy reported as unknown, never as zero" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fillColor=#FFFFFF;strokeColor=#C08A11;fontColor=#5a3f05;" vertex="1" parent="1">
          <mxGeometry x="695" y="552" width="350" height="76" as="geometry" />
        </mxCell>

        <!-- ==== package root ==== -->
        <mxCell id="pkg_root" value="package root — config &amp; adapters" style="shape=folder;tabWidth=200;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#F4F1FA;strokeColor=#7A5FB0;fontColor=#2f2352;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="270" y="680" width="790" height="130" as="geometry" />
        </mxCell>
        <mxCell id="m_config" value="&lt;b&gt;config.py&lt;/b&gt;&#10;walks up to the nearest .env&#10;(process env always wins)&#10;DB · S3 · port · threads · OSRM" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#7A5FB0;fontColor=#2f2352;" vertex="1" parent="1">
          <mxGeometry x="285" y="718" width="245" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m_routing" value="&lt;b&gt;routing.py&lt;/b&gt;&#10;OSRM proxy — driver coords stay on our origin&#10;quantised-key TTL cache&#10;RoutingError → 502 → straight-line fallback" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#7A5FB0;fontColor=#2f2352;" vertex="1" parent="1">
          <mxGeometry x="542" y="718" width="245" height="76" as="geometry" />
        </mxCell>
        <mxCell id="m_s3" value="&lt;b&gt;s3.py&lt;/b&gt;&#10;one boto3 client for both sides&#10;put_frame (ingest) → s3:// uri&#10;get_frame_array (classify) → RGB" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#7A5FB0;fontColor=#2f2352;" vertex="1" parent="1">
          <mxGeometry x="799" y="718" width="246" height="76" as="geometry" />
        </mxCell>

        <!-- ===== entry points ===== -->
        <mxCell id="pkg_entry" value="entry points &amp; harnesses (not on the request path)" style="shape=folder;tabWidth=290;tabHeight=20;tabPosition=left;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontStyle=1;fillColor=#F7F8F9;strokeColor=#9AA6AE;fontColor=#33383d;spacingLeft=8;spacingTop=2;" vertex="1" parent="1">
          <mxGeometry x="250" y="870" width="830" height="180" as="geometry" />
        </mxCell>
        <mxCell id="m_server" value="&lt;b&gt;server.py&lt;/b&gt;&#10;uvicorn on API_PORT&#10;serves api.app:app" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#9AA6AE;fontColor=#33383d;" vertex="1" parent="1">
          <mxGeometry x="265" y="908" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="m_register" value="&lt;b&gt;register_drone.py&lt;/b&gt;&#10;mints an API key,&#10;stores only its SHA-256" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#9AA6AE;fontColor=#33383d;" vertex="1" parent="1">
          <mxGeometry x="465" y="908" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="m_replay" value="&lt;b&gt;replay.py&lt;/b&gt;&#10;golden test, no server:&#10;frames → pipeline → compare" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#9AA6AE;fontColor=#33383d;" vertex="1" parent="1">
          <mxGeometry x="665" y="908" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="m_replay_ing" value="&lt;b&gt;replay_ingest.py&lt;/b&gt;&#10;full-stack E2E over the&#10;real HTTP / WS contract" style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=10;fillColor=#FFFFFF;strokeColor=#9AA6AE;fontColor=#33383d;" vertex="1" parent="1">
          <mxGeometry x="865" y="908" width="190" height="66" as="geometry" />
        </mxCell>
        <mxCell id="m_uplink" value="&lt;b&gt;sim_uplink.py&lt;/b&gt; — live sidecar&#10;watches sim/output/&lt;area&gt;/ and POSTs each frame as a Webots flight writes it (map fills in mid-patrol).&#10;Reads only: the flight controller has NO network code, so a slow server can never cost it a physics step.&#10;Both it and replay_ingest post through ingest_client.py — one copy of the multipart wire format." style="rounded=0;html=1;whiteSpace=wrap;align=center;verticalAlign=middle;fontSize=9;fillColor=#FFFFFF;strokeColor=#9AA6AE;fontColor=#33383d;" vertex="1" parent="1">
          <mxGeometry x="265" y="984" width="790" height="52" as="geometry" />
        </mxCell>

        <!-- ===== backing services ===== -->
        <mxCell id="so" value="&#171;module&#187;&#10;vision/score_occupancy.py&#10;the calibrated classifier —&#10;imported VERBATIM, never copied" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=11;fillColor=#FFF6E0;strokeColor=#C08A11;fontColor=#5a3f05;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="240" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pg" value="&#171;database&#187;&#10;Postgres + PostGIS&#10;system of record" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EEF1F3;strokeColor=#6b7686;fontColor=#14181D;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="430" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="minio" value="&#171;datastore&#187;&#10;MinIO / S3&#10;frame pixels, 1-day TTL" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EEF1F3;strokeColor=#9AA6AE;fontColor=#14181D;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1150" y="610" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="osrm" value="&#171;external&#187;&#10;OSRM&#10;driving directions" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=11;fillColor=#EEF1F3;strokeColor=#9AA6AE;fontColor=#14181D;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="1150" y="740" width="200" height="66" as="geometry" />
        </mxCell>

        <!-- ===== edges: clients ===== -->
        <mxCell id="e_drone_app" value="&#171;HTTP&#187; POST /ingest/frame&#10;+ mission start/end (x-api-key)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#5b6670;fontColor=#33383d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="drone" target="m_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_browser_app" value="&#171;REST&#187; /bays · /summary · /route" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#2E9E57;fontColor=#0f4023;labelBackgroundColor=#ffffff;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.85;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="m_app">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_browser_hub" value="&#171;WebSocket&#187;&#10;/ws/occupancy?since=" style="endArrow=open;startArrow=open;startFill=0;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#2E9E57;fontColor=#0f4023;labelBackgroundColor=#ffffff;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="m_hub">
