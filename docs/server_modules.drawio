            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_admin_metrics" value="&#171;REST&#187; /api/v1/metrics&#10;polled every 3 s" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#0F9E90;fontColor=#06403a;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="m_metrics">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_op_entry" value="python -m parkdrone_vision.…" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#5b6670;fontColor=#33383d;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="operator" target="pkg_entry">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_server_app" value="uvicorn serves&#10;api.app:app" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#9AA6AE;fontColor=#33383d;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.12;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_server" target="m_app">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="242" y="941" />
              <mxPoint x="242" y="199" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_replay_pipe" value="reuses process_frame()&#10;— the golden test" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#9AA6AE;fontColor=#33383d;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.9;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_replay" target="m_pipeline">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="852" />
              <mxPoint x="1072" y="852" />
              <mxPoint x="1072" y="374" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- ===== edges: inside api/ ===== -->
        <mxCell id="e_app_auth" value="Depends(require_drone)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#0F9E90;fontColor=#06403a;labelBackgroundColor=#E4F7F4;exitX=0.2;exitY=1;exitDx=0;exitDy=0;entryX=0.2;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="m_app" target="m_auth">
