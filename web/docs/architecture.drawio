        <mxCell id="worker" value="&#171;component&#187;&#10;Vision Worker — Python&#10;reuses score_occupancy.py" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=12;fillColor=#FDE9E4;strokeColor=#E14B2E;fontColor=#5c1c10;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="415" y="520" width="280" height="90" as="geometry" />
