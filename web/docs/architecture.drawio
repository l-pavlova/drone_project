        <mxCell id="e_api_obj" value="&#171;S3&#187; put frame" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#5b6670;fontColor=#33383d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="api" target="objstore">
