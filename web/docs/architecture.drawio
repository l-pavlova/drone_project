        <mxCell id="e_user_api" value="&#171;REST + WebSocket&#187;" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#2E9E57;fontColor=#0f4023;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="user" target="api">
