        <!-- ===== dependencies ===== -->
        <mxCell id="e_drone_api" value="&#171;HTTP&#187; POST /ingest/frame&#10;(frame + pose, API key)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#5b6670;fontColor=#33383d;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="drone" target="api">
