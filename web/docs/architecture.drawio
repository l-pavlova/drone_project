        <mxCell id="admin" value="&#171;component&#187;&#10;Admin Dashboard&#10;(planned)" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=12;fillColor=#F1F3F5;strokeColor=#9AA6AE;fontColor=#6b747c;dashed=1;spacingLeft=8;" vertex="1" parent="1">
