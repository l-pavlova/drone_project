<mxfile host="app.diagrams.net" agent="parkdrone" version="24.0.0">
  <diagram name="PARKDRONE — Component Diagram" id="parkdrone-arch">
    <mxGraphModel dx="1100" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- title -->
        <mxCell id="title" value="PARKDRONE — Web System (UML Component Diagram)" style="text;html=1;align=left;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#14181D;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="640" height="30" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Dependencies are dashed «usage» arrows labelled with the protocol / operation. Cylinders are data stores." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6b747c;" vertex="1" parent="1">
          <mxGeometry x="60" y="46" width="720" height="20" as="geometry" />
        </mxCell>

        <!-- ===== components ===== -->
        <mxCell id="drone" value="&#171;component&#187;&#10;Drone / Webots Sim&#10;nadir frames + poses" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=12;fillColor=#EEF1F3;strokeColor=#9AA6AE;fontColor=#14181D;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="440" y="90" width="230" height="64" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&#171;component&#187;&#10;API — Node / Express&#10;ingest · read · WebSocket hub" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=12;fillColor=#E4F7F4;strokeColor=#0F9E90;fontColor=#06403a;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="415" y="215" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="objstore" value="&#171;datastore&#187;&#10;Object store&#10;MinIO / S3 — raw frames" style="shape=cylinder3;html=1;whiteSpace=wrap;boundedLbl=1;backgroundOutline=1;size=14;fillColor=#EEF1F3;strokeColor=#9AA6AE;fontColor=#14181D;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="70" y="360" width="190" height="100" as="geometry" />
        </mxCell>

        <mxCell id="redis" value="&#171;message broker&#187;&#10;Redis&#10;jobs list · deltas pub/sub" style="shape=component;html=1;whiteSpace=wrap;rounded=0;align=center;verticalAlign=middle;fontSize=12;fillColor=#FBF1DA;strokeColor=#C79A2E;fontColor=#5b4611;spacingLeft=8;" vertex="1" parent="1">
          <mxGeometry x="450" y="375" width="210" height="72" as="geometry" />
