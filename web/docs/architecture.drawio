        <mxCell id="e_admin_api" value="&#171;REST&#187; (planned)" style="endArrow=open;endFill=0;dashed=1;html=1;fontSize=10;strokeColor=#9AA6AE;fontColor=#6b747c;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="admin" target="api">
