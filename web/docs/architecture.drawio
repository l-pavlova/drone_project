        <!-- foundation note -->
        <mxCell id="note" value="packages/contracts — shared TS types + zod + the ENU projection mirrored from the sim: the coordinate spine every component speaks." style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#6b747c;" vertex="1" parent="1">
