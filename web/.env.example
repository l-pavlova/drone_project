# Copy to `.env` (gitignored) before running anything: `cp -n .env.example .env`
#
# This is a TEMPLATE, not a set of working defaults: every password below is the
# placeholder CHANGE_ME_local_dev and is meant to be replaced in your own `.env`
# (which stays gitignored). Nothing in the repo — not compose, not config.py —
# falls back to a credential, so a value only ever has to change here.
# For anything reachable beyond localhost, use generated secrets from a real
# secret store rather than a .env file.
#
# Quick local start: `cp -n .env.example .env`, then
# `sed -i "s/CHANGE_ME_local_dev/$(openssl rand -hex 16)/g" .env`
# (any 8+ character string works — MinIO rejects shorter root passwords).

# Postgres + PostGIS. POSTGRES_* are consumed by docker-compose to provision the
# container; DATABASE_URL is what the server connects with. Keep them in sync —
# the user/password/db name appear in both. The password is baked into the
# container's data volume at first start: after changing it, drop the volume
# (`docker compose --env-file .env -f infra/docker-compose.yml down -v`) or ALTER
# the role, otherwise Postgres keeps the old password.
POSTGRES_USER=parkdrone
POSTGRES_PASSWORD=CHANGE_ME_local_dev
POSTGRES_DB=parkdrone
DATABASE_URL=postgres://parkdrone:CHANGE_ME_local_dev@localhost:5432/parkdrone

# Object store (S3-compatible; MinIO in dev).
# S3_ACCESS_KEY/S3_SECRET_KEY double as MinIO's root credentials in compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parkdrone-frames
S3_ACCESS_KEY=parkdrone-dev
S3_SECRET_KEY=CHANGE_ME_local_dev

# Path to the source bay geometry used by the seeder. Optional: if unset, the
# seeder defaults to the repo's data/block_bays.geojson (resolved from source).
# If set, it is resolved relative to the process CWD.
# BAYS_GEOJSON=/abs/path/to/block_bays.geojson

# API
API_PORT=4000
# Dedicated classify threads draining the in-process job queue. 0 starts the
# server without draining it (used to stage frames for the restart-recovery test).
# CLASSIFY_THREADS=4

# ---- multi-replica (migration 0011) ----------------------------------------
# Several server processes can share one Postgres. Work is CLAIMED with
# FOR UPDATE SKIP LOCKED, so they split one backlog instead of both doing all of
# it; deltas cross replicas over LISTEN/NOTIFY. Every default below works
# unchanged for a single process — nothing here has to be set to run one.
#
# Who this replica calls itself when it claims. Defaults to hostname:pid; set it
# to something readable (A, B, pod name) when running more than one by hand.
# REPLICA_ID=
# How long the dispatcher waits before polling for work ingested elsewhere.
# CLAIM_POLL_S=1.0
# Local prefetch, as a multiple of CLASSIFY_THREADS. Small on purpose: a replica
# that claims the whole backlog holds leases on work it will not start for
# minutes.
# CLAIM_PREFETCH=2
# Lease length. Must exceed prefetch depth x per-frame classify time. Also how
# long a dead replica's in-flight work waits before someone else takes it over.
# LEASE_S=300
# Give up on a job after this many claims (before 0011 a failing job was retried
# on every restart, forever).
# MAX_ATTEMPTS=3

# WebSocket delta channel. bay_delta is the shared replay buffer and its id is
# the cursor clients resume from — so ?since= means the same thing on every
# replica. Swept by the same pass that expires frames.
# DELTA_RETENTION_S=3600
# DELTA_REPLAY_MAX=500
# Replay slightly BEHIND the client's cursor: sequence ids are assigned before
# commit, so one can become visible out of order. Deltas are idempotent, so
# over-replaying a few is free and missing one is not.
# DELTA_REPLAY_SLACK=50

# Manual occupancy toggle (POST /api/v1/dev/occupy|free), which drives the map
# by hand. OFF unless set: those endpoints have no auth, so anyone who can reach
# the port could flip any bay. Opt in for local dev only.
ENABLE_DEV_ROUTES=true

# Shared secret for the operational endpoints (/api/v1/metrics and /metrics).
# Those expose queue depth, ingest rates, fleet state and model accuracy - an
# operational map of the system, which is a different thing from a bay's
# occupancy being public. Set it and both endpoints require the `x-admin-key`
# header; leave it EMPTY and they stay open, which the server warns about at
# startup. The ops dashboard's vite proxy reads this file and injects the header
# for you, so :5174 keeps working either way.
# A shared key is the smallest thing that closes the door - a real admin login
# (sessions, users, audit) is still open P7 work.
ADMIN_API_KEY=

# How far back an observation counts toward a bay's occupancy vote, and how old
# bay_state may be before reads report the bay as unknown. MUST exceed the survey
# period: the vote is per (bay, survey area) over this window, so a patrol longer
# than the window expires its own early bays before it lands. The 1 km route is
# 1976 waypoints — over an hour at cruise.
# OCCUPANCY_WINDOW_S=7200

# Frame retention. After this age a frame's row and its stored image are deleted
# by the background sweep; `observation` and `mission` are kept. Set
# CLEANUP_INTERVAL_S=0 to disable the sweep (the tests drive it by hand).
# FRAME_RETENTION_S=14400
# CLEANUP_INTERVAL_S=900

# Driving directions: OSRM instance the /api/v1/route proxy calls. The public
# demo server is rate-limited — point this at a self-hosted OSRM for production.
OSRM_BASE=https://router.project-osrm.org
OSRM_TIMEOUT_S=6
ROUTE_CACHE_TTL_S=60
