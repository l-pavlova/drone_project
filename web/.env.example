# Copy to `.env` (gitignored) before running anything: `cp -n .env.example .env`
#
# These are LOCAL DEV defaults. infra/docker-compose.yml has no credentials of
# its own — it reads the values below — so a password only has to change here.
# For anything reachable beyond localhost, replace these with generated secrets
# from a real secret store, not a .env file.

# Postgres + PostGIS. POSTGRES_* are consumed by docker-compose to provision the
# container; DATABASE_URL is what the server connects with. Keep them in sync —
# the user/password/db name appear in both.
POSTGRES_USER=parkdrone
POSTGRES_PASSWORD=parkdrone
POSTGRES_DB=parkdrone
DATABASE_URL=postgres://parkdrone:parkdrone@localhost:5432/parkdrone

# Object store (S3-compatible; MinIO in dev).
# S3_ACCESS_KEY/S3_SECRET_KEY double as MinIO's root credentials in compose.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=parkdrone-frames
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Path to the source bay geometry used by the seeder. Optional: if unset, the
# seeder defaults to the repo's data/block_bays.geojson (resolved from source).
# If set, it is resolved relative to the process CWD.
# BAYS_GEOJSON=/abs/path/to/block_bays.geojson

# API
API_PORT=4000
# Dedicated classify threads draining the in-process job queue. 0 starts the
# server without draining it (used to stage frames for the restart-recovery test).
# CLASSIFY_THREADS=4

# Manual occupancy toggle (POST /api/v1/dev/occupy|free), which drives the map
# by hand. OFF unless set: those endpoints have no auth, so anyone who can reach
# the port could flip any bay. Opt in for local dev only.
ENABLE_DEV_ROUTES=true

# Driving directions: OSRM instance the /api/v1/route proxy calls. The public
# demo server is rate-limited — point this at a self-hosted OSRM for production.
OSRM_BASE=https://router.project-osrm.org
OSRM_TIMEOUT_S=6
ROUTE_CACHE_TTL_S=60
