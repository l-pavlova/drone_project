{
  "name": "parkdrone-web",
  "version": "0.1.0",
  "private": true,
  "description": "PARKDRONE web infrastructure: ingest API, real-time occupancy push, dashboards.",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.7.0",
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:migrate": "pnpm --filter @parkdrone/db migrate",
    "db:seed": "pnpm --filter @parkdrone/db seed",
    "quickstart": "bash scripts/quickstart.sh",
    "infra:up": "docker compose --env-file .env -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file .env -f infra/docker-compose.yml down"
  },
  "devDependencies": {
    "typescript": "^5.5.4"
  }
}
