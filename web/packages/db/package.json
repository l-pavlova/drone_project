{
  "name": "@parkdrone/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed-runs": "tsx src/seed-runs.ts"
  },
  "dependencies": {
    "@parkdrone/contracts": "workspace:*",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.6",
    "dotenv": "^16.4.5",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}
